{
  "name": "catalogue",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/catalogue/src",
  "tags": ["scope:shared", "type:domain"],
  "targets": {
    "build": {
      "command": "tsc -p libs/catalogue/tsconfig.json",
      "cache": true,
      "inputs": ["production"],
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "command": "tsx --test libs/catalogue/src/*.test.ts",
      "cache": true,
      "dependsOn": ["build"]
    }
  }
}

# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data
.nx/migrate-runs
.claude/worktrees
.claude/settings.local.json

.angular

# TypeScript incremental metadata
*.tsbuildinfo

# Downloaded/generated workshop media; keep the attribution document in Git.
/.cache/cinema-media/
/apps/movie-theater/public/media/*.mp4
/apps/movie-theater/public/media/*.jpg
/docs/screenshots/

# Optional detector: source model and runtime binaries are downloaded/copied locally.
/apps/movie-theater/public/models/*
!/apps/movie-theater/public/models/NOTICE.md
!/apps/movie-theater/public/models/YOLOX-LICENSE.txt
!/apps/movie-theater/public/models/ONNX-RUNTIME-LICENSE.txt

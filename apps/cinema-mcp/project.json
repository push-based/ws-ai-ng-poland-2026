{
  "name": "cinema-mcp",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/cinema-mcp/src",
  "tags": ["scope:server", "type:app"],
  "targets": {
    "build": {
      "command": "tsc -b apps/cinema-mcp/tsconfig.json",
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"]
    },
    "serve": {
      "command": "node apps/cinema-mcp/dist/main.js",
      "dependsOn": ["build"],
      "continuous": true
    },
    "test": {
      "command": "tsx --test apps/cinema-mcp/src/*.test.ts",
      "dependsOn": ["build"],
      "cache": true
    }
  }
}

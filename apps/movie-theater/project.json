{
  "name": "movie-theater",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/movie-theater/src",
  "tags": ["scope:browser", "type:app"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/movie-theater",
        "browser": "apps/movie-theater/src/main.ts",
        "tsConfig": "apps/movie-theater/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/movie-theater/public"
          }
        ],
        "styles": ["apps/movie-theater/src/styles.css"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "12kb",
              "maximumError": "18kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "dependsOn": ["^build", "media-check"],
      "inputs": [
        "production",
        "^production",
        {
          "runtime": "tsx tools/download-media.ts --fingerprint"
        }
      ]
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "movie-theater:build:production"
        },
        "development": {
          "buildTarget": "movie-theater:build:development"
        }
      },
      "dependsOn": ["^build", "media-check"],
      "options": {
        "prebundle": {
          "exclude": ["@nano-cinema/catalogue"]
        }
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "movie-theater:build",
        "staticFilePath": "dist/apps/movie-theater/browser",
        "spa": true
      },
      "dependsOn": ["build"]
    },
    "test": {
      "command": "tsx --test apps/movie-theater/src/app/core/*.test.ts",
      "dependsOn": ["^build"],
      "cache": true
    },
    "media-check": {
      "command": "tsx tools/download-media.ts --check",
      "cache": false
    }
  }
}
